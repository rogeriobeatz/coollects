# Set both public values in Vercel / Development:
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# Optional AI recognition (KIE, Gemini model). If unset, the capture screen
# hides the AI and asks for manual filling. Server-only: never NEXT_PUBLIC_.
KIE_API_KEY=

# Public address of the site (used in WhatsApp/social link previews).
# Optional on Vercel, which detects the production URL automatically.
NEXT_PUBLIC_SITE_URL=
